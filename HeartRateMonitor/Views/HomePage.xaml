<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HeartRateMonitor.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:HeartRateMonitor.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HeartRateMonitor.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,4,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面标题  -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="实时监测" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="扫描并连接支持标准心率服务（BLE Heart Rate Service）的蓝牙设备，实时读取心率数据。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  提示条  -->
        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="1"
            Margin="0,16,0,0"
            IsClosable="True"
            IsOpen="False" />

        <!--  主体：左设备列表 / 右实时心率  -->
        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== 蓝牙设备卡片 =====  -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="18" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  卡片头  -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="蓝牙设备" />
                            <TextBlock
                                x:Name="ScanStatusText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="尚未扫描" />
                        </StackPanel>

                        <Button
                            x:Name="ScanButton"
                            Grid.Column="1"
                            Click="OnScanClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="扫描" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  设备列表 / 空状态  -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ListView
                                x:Name="DeviceList"
                                SelectionChanged="OnDeviceSelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:BleDeviceInfo">
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind DisplayText}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind local:DeviceDisplay.FormatRssi(Rssi)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <FontIcon
                                    FontSize="26"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE703;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="暂无设备" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="点击「扫描」查找附近的心率设备" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  连接按钮  -->
                    <Button
                        x:Name="ConnectButton"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnConnectClick"
                        Content="连接设备"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!--  ===== 实时心率卡片 =====  -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="18" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  卡片头 + 连接状态  -->
                    <Grid Grid.Row="0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="当前心率" />

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                x:Name="ConnectionStateText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="未连接" />
                        </StackPanel>
                    </Grid>

                    <!--  心率读数  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <Grid
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center">
                            <Path
                                x:Name="HeartIcon"
                                Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.28 2,8.5 C 2,5.42 4.42,3 7.5,3 C 9.24,3 10.91,3.81 12,5.09 C 13.09,3.81 14.76,3 16.5,3 C 19.58,3 22,5.42 22,8.5 C 22,12.28 18.6,15.36 13.45,20.04 L 12,21.35 Z"
                                Fill="{StaticResource HeartAccentBrush}"
                                Opacity="0.85"
                                RenderTransformOrigin="0.5,0.5"
                                Stretch="Uniform">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <!--  占位读数：接入真实数据后置为不透明  -->
                            <TextBlock
                                x:Name="HeartRateText"
                                VerticalAlignment="Center"
                                FontSize="88"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource HeartAccentBrush}"
                                IsTextScaleFactorEnabled="False"
                                Opacity="0.4"
                                Text="--" />
                            <TextBlock
                                Margin="0,0,0,24"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="BPM" />
                        </StackPanel>

                        <TextBlock
                            x:Name="HeartHintText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="连接设备后显示实时心率" />
                    </StackPanel>

                    <!--  底部操作区  -->
                    <Border
                        Grid.Row="2"
                        Padding="0,12,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox
                                x:Name="TopMostPinCheck"
                                VerticalAlignment="Center"
                                Checked="OnPinnedChanged"
                                Content="置顶并固定"
                                Unchecked="OnPinnedChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
